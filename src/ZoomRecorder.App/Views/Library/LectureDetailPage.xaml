<Page
    x:Class="ZoomRecorder.App.Views.Library.LectureDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="36" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="Back" Click="BackClicked" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Transcribe locally" Style="{ThemeResource AccentButtonStyle}" Click="ProcessClicked" />
        </Grid>
        <TabView Grid.Row="1" Margin="0,18,0,0" IsAddTabButtonVisible="False">
            <TabViewItem Header="Summary"><TextBlock Text="{Binding StudyMaterialsUnavailableText}" Padding="16" /></TabViewItem>
            <TabViewItem Header="Notes"><TextBlock Text="{Binding StudyMaterialsUnavailableText}" Padding="16" /></TabViewItem>
            <TabViewItem Header="Transcript">
                <Grid Padding="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox Text="{Binding TranscriptText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Save transcript" Click="SaveTranscriptClicked" />
                        <TextBlock Text="Saved locally." VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="Key terms"><TextBlock Text="{Binding StudyMaterialsUnavailableText}" Padding="16" /></TabViewItem>
            <TabViewItem Header="Assignments"><TextBlock Text="{Binding StudyMaterialsUnavailableText}" Padding="16" /></TabViewItem>
            <TabViewItem Header="Review questions"><TextBlock Text="{Binding StudyMaterialsUnavailableText}" Padding="16" /></TabViewItem>
        </TabView>
    </Grid>
</Page>
