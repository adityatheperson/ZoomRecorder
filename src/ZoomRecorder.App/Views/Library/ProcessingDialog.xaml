<ContentDialog
    x:Class="ZoomRecorder.App.Views.Library.ProcessingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transcribe locally"
    PrimaryButtonText="{Binding PrimaryActionText}"
    CloseButtonText="Cancel"
    CloseButtonClick="CancelClicked"
    PrimaryButtonClick="StartClicked">
    <StackPanel Width="480" Spacing="12">
        <InfoBar IsOpen="True" Severity="Informational" Title="Local transcription"
                 Message="Audio stays on this computer. The English model downloads once, then works offline." />
        <TextBlock Text="{Binding ClassName}" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Value="{Binding ProgressValue}"
                     Maximum="{Binding ProgressMaximum}" />
        <TextBlock Text="{Binding StatusText}" />
        <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Processing stopped"
                 Message="{Binding StatusText}" />
    </StackPanel>
</ContentDialog>
