<ContentDialog
    x:Class="ZoomRecorder.App.Views.Library.ProcessingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create study materials"
    PrimaryButtonText="Start processing"
    CloseButtonText="Cancel"
    PrimaryButtonClick="StartClicked">
    <StackPanel Width="480" Spacing="12">
        <InfoBar IsOpen="True" Severity="Informational" Title="Cloud processing"
                 Message="Meeting audio will be sent to OpenAI only after you start." />
        <TextBlock Text="{Binding ClassName}" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="{Binding EstimatedUploadText}" />
        <TextBlock Text="{Binding EstimatedCostText}" />
        <CheckBox Content="Delete the MP4 after verified processing" IsChecked="{Binding DeleteVideoAfterSuccess, Mode=TwoWay}" />
        <ProgressBar IsIndeterminate="{Binding IsProcessing}" />
        <TextBlock Text="{Binding StatusText}" />
        <InfoBar IsOpen="{Binding HasError}" Severity="Error" Title="Processing stopped"
                 Message="{Binding StatusText}" />
    </StackPanel>
</ContentDialog>
