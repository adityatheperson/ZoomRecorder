<Page
    x:Class="ZoomRecorder.App.Views.Library.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36" Width="680" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <ToggleSwitch x:Name="NightModeToggle"
                          Header="Night mode"
                          OffContent="Day mode"
                          OnContent="Night mode"
                          IsOn="{Binding NightModeEnabled, Mode=TwoWay}"
                          Toggled="NightModeToggled" />
            <TextBlock Text="Use a darker color theme throughout Zoom Recorder. Day mode is used by default."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="Recording preferences" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <CheckBox Content="Default future jobs to delete video after verified processing"
                      IsChecked="{Binding DeleteVideoByDefault, Mode=TwoWay}" />
            <Button Content="Save preferences" HorizontalAlignment="Left" Click="SavePreferencesClicked" />
            <TextBlock Text="Storage locations" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="New files use these folders after Zoom Recorder is restarted. Existing files are not moved."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Recordings" FontWeight="SemiBold" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding RecordingsDirectory, Mode=TwoWay}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseRecordingsClicked" />
            </Grid>
            <TextBlock Text="Transcripts" FontWeight="SemiBold" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding TranscriptsDirectory, Mode=TwoWay}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseTranscriptsClicked" />
            </Grid>
            <Button Content="Save storage locations" HorizontalAlignment="Left" Click="SaveStorageLocationsClicked" />
            <InfoBar x:Name="PreferencesStatus" IsOpen="False" />
            <TextBlock Text="Privacy" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding PrivacyText}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
