<Page
    x:Class="ZoomRecorder.App.Views.Library.ClassDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:libraryVm="using:ZoomRecorder.App.ViewModels.Library">
    <Grid Padding="36" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="14">
            <Button Content="Back to classes" HorizontalAlignment="Left" Click="BackClicked" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ClassName}" Style="{ThemeResource TitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Term}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="·" />
                        <TextBlock Text="{Binding LectureCount}" />
                        <TextBlock Text="lectures" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Record a class" Click="RecordClassClicked" />
                    <Button Content="Open study guide" Style="{ThemeResource AccentButtonStyle}" Click="OpenStudyGuideClicked" />
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" PlaceholderText="Search this class by file name" />
                <Button Grid.Column="1" Content="Search" Click="SearchClicked" />
            </Grid>
            <StackPanel x:Name="ErrorPanel" Spacing="8">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                <Button Content="Retry library" HorizontalAlignment="Left" Click="RetryClicked" />
            </StackPanel>
        </StackPanel>

        <TabView Grid.Row="1" x:Name="DetailsTabs" Margin="0,18,0,0" IsAddTabButtonVisible="False">
            <TabViewItem Header="Lectures">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                        <InfoBar x:Name="DeletionErrorPanel" Title="Deletion failed" Severity="Error" IsClosable="False"
                                 Message="{Binding DeletionErrorMessage}" />
                        <InfoBar x:Name="RenameErrorPanel" Title="Rename failed" Severity="Error" IsClosable="False"
                                 Message="{Binding RenameErrorMessage}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="NoLecturesPanel" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="No lectures in this class yet." Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Button Content="Record a class" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Click="RecordClassClicked" />
                        </StackPanel>
                        <ListView x:Name="LecturesList" ItemsSource="{Binding Lectures}" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="LectureClicked">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="libraryVm:RecordingListItem">
                                    <Grid Padding="12,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind RecordedAtText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Rename" Click="RenameClicked" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="Delete" Click="DeleteClicked" VerticalAlignment="Center"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabViewItem>
            <TabViewItem Header="Study guide">
                <StackPanel Padding="20" Spacing="8">
                    <TextBlock Text="Class study guide" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="The guide combines completed lectures in recording order. A pending badge appears while it is rebuilding." TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="Assignments">
                <StackPanel Padding="20" Spacing="8">
                    <TextBlock Text="Assignments" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Confirmed edits are preserved when study materials are refreshed." TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="Class settings">
                <StackPanel Padding="20" Spacing="8">
                    <TextBlock Text="Remembered meetings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Forget a remembered meeting ID to change only future recording assignments; existing lectures stay in this class." TextWrapping="Wrap" />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
