<Page
    x:Class="ZoomRecorder.App.Views.MeetingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#101214">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="ZoomHostSurface">
            <TextBlock Text="Zoom meeting host" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" Background="#EAF7F1" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#D93025" />
                <TextBlock x:Name="RecordingTimerText" Text="Recording · 00:00:00" Foreground="#145C3D" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Meeting audio ✓" Foreground="#145C3D" />
                <TextBlock Text="Microphone ✓" Foreground="#145C3D" />
                <TextBlock Text="Saved locally ✓" Foreground="#145C3D" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
