<Page
    x:Class="ZoomRecorder.App.Views.CompletionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Width="520" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Recording saved" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="meeting.mp4 · 42:00 · 50.0 MB" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open recording" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Open folder" />
                <Button Content="Done" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
