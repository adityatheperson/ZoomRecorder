<Page
    x:Class="ZoomRecorder.App.Views.CompletionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Width="520" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Recording saved" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding FileName}" /><Run Text=" · " /><Run Text="{Binding DurationText}" /><Run Text=" · " /><Run Text="{Binding FileSizeText}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Open recording" Style="{ThemeResource AccentButtonStyle}" Click="OpenRecording" />
                <Button Content="Open folder" Click="OpenFolder" />
                <Button Content="Done" Click="Done" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
