<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ZoomRecorder.Core\ZoomRecorder.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\ZoomRecorder.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WhisperWorkersRoot Condition="'$(WhisperWorkersRoot)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\whisper-workers</WhisperWorkersRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\ZoomRecorder.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Whisper\model-small.en.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(WhisperWorkersRoot)')">
    <Content Include="$(WhisperWorkersRoot)\**\*">
      <Link>tools\whisper\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyApplicationPriToPublishDirectory" AfterTargets="Publish">
    <PropertyGroup>
      <ApplicationPriPath>$(TargetDir)$(AssemblyName).pri</ApplicationPriPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(ApplicationPriPath)')"
           Text="The compiled application PRI was not generated at $(ApplicationPriPath)." />
    <Copy SourceFiles="$(ApplicationPriPath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
